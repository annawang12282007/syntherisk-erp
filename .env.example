NODE_ENV=development
APP_URL=http://localhost:3030
PORT=3030
DATABASE_URL=postgresql://syntherisk_erp:GENERATE_A_PASSWORD@127.0.0.1:55434/syntherisk_erp
BETTER_AUTH_SECRET=GENERATE_AT_LEAST_32_RANDOM_BYTES
INTEGRATION_ENCRYPTION_KEY=GENERATE_32_RANDOM_BYTES_BASE64
ATTACHMENT_DIR=./data/attachments
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_INTEGRATION_REDIRECT_URI=http://localhost:3030/api/integrations
GOOGLE_LOGIN_ENABLED=false
SMTP_HOST=
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_SECURE=false
SMTP_REQUIRE_TLS=false
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Required only when enabling Google integrations/login; your own verified domain.
GOOGLE_WORKSPACE_DOMAIN=
AUTH_REQUIRE_EMAIL_VERIFICATION=false
# Set file-test only for isolated localhost acceptance; never delivers mail.
AUTH_MAIL_MODE=smtp
AUTH_MAIL_DIR=./data/auth-mail

# Real integration verification scripts require an explicitly isolated database.
# Keep false on business installations; test writers require a disposable database.
INTEGRATION_SANDBOX=false
# Production SMTP: port 465 + SMTP_SECURE=true, or 587 + SMTP_REQUIRE_TLS=true.
# APP_URL and both Google Console redirect URIs must be updated together for HTTPS.


# Cloud export uses the member Drive grant; no extra client/key is required.
# App and worker require outbound HTTPS to Google APIs and TLS SMTP.
# Pausing auto sync preserves manual reads; external writes require resuming.

# File assistant: server and worker only. Leave the key empty to disable analysis.
ANTHROPIC_API_KEY=
# Required for an organization-scoped key; omit for a single-workspace key.
ANTHROPIC_WORKSPACE_ID=
ANTHROPIC_MODEL=claude-sonnet-5-5
CLAUDE_MONTHLY_BUDGET_USD=10

# Modified deployments must link their corresponding source.
NEXT_PUBLIC_SOURCE_URL=https://github.com/annawang12282007/syntherisk-erp
NEXT_PUBLIC_LICENSE_URL=https://github.com/annawang12282007/syntherisk-erp/blob/main/LICENSE
