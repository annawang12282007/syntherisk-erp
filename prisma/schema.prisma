  company_id       String     @id @db.Uuid
  version          Int        @default(1)
  first_year_start DateTime   @db.Date
  first_year_end   DateTime   @db.Date
  end_month        Int        @db.SmallInt
  end_day          Int?       @db.SmallInt
  updated_by       String
  updated_at       DateTime   @default(now()) @db.Timestamptz(6)
