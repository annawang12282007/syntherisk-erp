{
  "name": "syntherisk-erp",
  "version": "0.1.0",
  "description": "Self-hosted open-source ERP with Taiwan workforce operations",
  "license": "AGPL-3.0-only",
  "repository": {"type": "git", "url": "https://github.com/annawang12282007/syntherisk-erp.git"},
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "packageManager": "pnpm@11.19.0",
  "scripts": {
    "dev": "node scripts/sync-fonts.mjs && next dev --hostname 127.0.0.1 --port 3030",
    "build": "node scripts/sync-fonts.mjs && next build && node scripts/sanitize-build.mjs",
    "start": "node scripts/start.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:node": "node --test tests/*.node.mjs",
    "test:isolated": "node scripts/test-isolated.mjs",
    "acceptance": "tsx scripts/acceptance-server.ts",
    "deployment:check": "node scripts/deployment-check.mjs",
    "test:e2e": "playwright test",
    "db:start": "tsx scripts/database.ts",
    "db:migrate": "prisma migrate deploy",
    "db:introspect": "prisma db pull",
    "setup": "tsx scripts/setup.ts",
    "setup:compose": "tsx scripts/setup-compose.ts",
    "release:check": "node scripts/public-release-scan.mjs && node --test tests/public-release-scan.node.mjs",
    "notices": "node scripts/third-party-notices.mjs",
    "admin": "tsx scripts/admin.ts",
    "seed:demo": "tsx scripts/seed.ts",
    "worker": "tsx scripts/worker.ts",
    "backup": "tsx scripts/backup.ts",
    "restore": "tsx scripts/restore.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.922.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@fontsource-variable/noto-sans-sc": "5.3.0",
    "@fontsource-variable/noto-sans-tc": "5.3.0",
    "@tanstack/react-table": "^8.21.3",
    "better-auth": "1.7.7",
    "csv-parse": "7.0.3",
    "csv-stringify": "^6.6.0",
    "date-fns": "^4.1.0",
    "date-fns-tz": "^3.2.0",
    "decimal.js": "^10.6.0",
    "lucide-react": "^0.577.0",
    "next": "16.4.0",
    "nodemailer": "10.0.15",
    "opencc-js": "^1.4.2",
    "pg": "^8.16.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sanitize-html": "^2.18.0",
    "sharp": "0.35.5",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@prisma/client": "7.10.0",
    "@types/node": "^24.10.0",
    "@types/nodemailer": "8.0.2",
    "@types/opencc-js": "^1.0.3",
    "@types/pg": "^8.15.6",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@types/sanitize-html": "^2.16.2",
    "dotenv": "^17.2.3",
    "embedded-postgres": "18.4.0-beta.17",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.0",
    "prisma": "7.10.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^4.0.3"
  }
}
